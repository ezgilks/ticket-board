# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://ticket:ticket@localhost:5433/ticketboard?schema=public"
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Proxy hops in front of the API (1 locally; 3 on Render)
TRUST_PROXY=1
CORS_ORIGIN="http://localhost:5173"
# Optional — caching + multi-instance sockets
REDIS_URL="redis://localhost:6379"
# Optional — embeddings + AI triage
AI_SERVICE_URL="http://localhost:8001"
# Optional locally; required in production (must match ai-service's AI_SERVICE_TOKEN)
AI_SERVICE_TOKEN=""
