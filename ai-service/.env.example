# Triage provider: auto (default) | gemini | anthropic | keyword
# auto = Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else keyword rules.
TRIAGE_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Shared secret the API must send (X-Service-Token). Leave blank locally.
AI_SERVICE_TOKEN=
